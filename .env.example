# Strength Atlas MVP environment template
# Copy to .env and fill with real values. Never commit real secrets.

# Core runtime
ATLAS_APP_ENV=development
# Vercel Large Functions beta; set this in Vercel Project Settings for deployments.
# Requires Fluid Compute and applies only after a new deployment.
# VERCEL_SUPPORT_LARGE_FUNCTIONS=1
# Production: set to "production" and provide explicit CORS + trusted hosts.
# Example DSN format only; never commit real credentials.
ATLAS_DATABASE_URL=postgresql+psycopg://<db_user>:<db_password>@<db_host>:5432/<db_name>

# Supabase
ATLAS_SUPABASE_URL=https://<project-ref>.supabase.co
ATLAS_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
ATLAS_SUPABASE_SERVICE_KEY=<supabase-service-role-key>
ATLAS_SUPABASE_STORAGE_BUCKET=atlas-raw
ATLAS_SUPABASE_JWT_AUDIENCE=authenticated
# Optional explicit overrides:
# ATLAS_SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# ATLAS_SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Browser Use
ATLAS_BROWSER_USE_API_KEY=<browser-use-api-key>
ATLAS_BROWSER_USE_POLL_TIMEOUT_SECONDS=300
ATLAS_BROWSER_USE_EXTRACT_MODEL_PRIMARY=bu-mini
ATLAS_BROWSER_USE_EXTRACT_MODEL_FALLBACK=bu-max
ATLAS_MAX_CRAWL_RETRIES=2

# Discovery + ops controls
ATLAS_DISCOVERY_MAX_CANDIDATES_PER_RUN=200
ATLAS_DISCOVERY_BLOCKED_PATH_TOKENS=wp-admin,wp-json,feed,cart,checkout,my-account,privacy-policy,terms,cookie-policy,login,register,author,tag
ATLAS_OPS_PER_DOMAIN_LIMIT=10
ATLAS_OPS_GLOBAL_LIMIT=50
ATLAS_OPS_FAILURE_RATE_THRESHOLD=0.35
ATLAS_OPS_RUNS_LEDGER_PATH=var/atlas/runs.jsonl
ATLAS_RETRIEVAL_DEBUG_TRACE_PATH=var/atlas/retrieval-debug.jsonl

# Optional learned reranking. Leave blank to retain baseline retrieval order.
ATLAS_RERANKER_MODEL_PATH=var/atlas/models/strength-atlas-cross-encoder-authoritative-v1
ATLAS_RERANKER_CANDIDATE_DEPTH=50
ATLAS_RERANKER_MAX_LENGTH=256
ATLAS_RERANKER_BATCH_SIZE=16

# API security/runtime
ATLAS_API_DOCS_ENABLED=true
ATLAS_CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ATLAS_TRUSTED_HOSTS=localhost,127.0.0.1
ATLAS_ENFORCE_HTTPS_REDIRECT=false
ATLAS_REQUEST_MAX_BODY_BYTES=131072
ATLAS_ASK_REQUEST_TIMEOUT_SECONDS=30

# Ask quota and rate limiting
ATLAS_ASK_LIFETIME_LIMIT=5
ATLAS_ASK_IP_RATE_LIMIT_WINDOW_SECONDS=60
ATLAS_ASK_IP_RATE_LIMIT_MAX_REQUESTS=30
ATLAS_ASK_USER_RATE_LIMIT_WINDOW_SECONDS=60
ATLAS_ASK_USER_RATE_LIMIT_MAX_REQUESTS=20
ATLAS_ASK_CONTACT_CTA_URL=mailto:support@strengthatlas.app
